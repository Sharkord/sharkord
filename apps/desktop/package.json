{
  "name": "@sharkord/desktop",
  "productName": "sharkord-app",
  "private": true,
  "version": "0.1.6",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "package": "electron-vite build && electron-builder",
    "package:dev": "bun run package --publish never",
    "package:dev-linux": "bun run package --linux --publish never",
    "package:dev-win": "bun run package --win --publish never",
    "package:dev-mac": "bun run package --mac --publish never",
    "test": "ELECTRON_OVERRIDE_DIST_PATH=. bun test",
    "lint": "eslint ./src --ext ts,tsx",
    "lint:fix": "eslint ./src --ext ts,tsx --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "format": "prettier --write \"**/*.ts*\"",
    "format:check": "prettier --check \"**/*.ts*\"",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@sharkord/shared": "workspace:*",
    "@sharkord/ui": "workspace:*",
    "@tailwindcss/vite": "^4.1.13",
    "@types/bun": "1.3.14",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react-swc": "^4.1.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-unused-imports": "^4.1.4",
    "filesize": "^11.0.13",
    "globals": "^16.4.0",
    "i18next": "^25.8.14",
    "i18next-resources-to-backend": "^1.2.1",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-i18next": "^16.5.6",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^7.1.7",
    "zod": "^4.3.5"
  },
  "description": "Sharkord desktop app",
  "author": "Sharkord",
  "homepage": "https://sharkord.com",
  "desktopName": "com.sharkord.Sharkord.desktop",
  "dependencies": {
    "dbus-next": "0.10.2",
    "electron-updater": "^6.8.11"
  },
  "optionalDependencies": {
    "@vencord/venmic": "7.2.3"
  }
}
