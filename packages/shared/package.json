{
  "name": "@sharkord/shared",
  "version": "0.0.31",
  "type": "module",
  "sideEffects": false,
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "format": "prettier --write \"**/*.ts*\"",
    "format:check": "prettier --check \"**/*.ts*\"",
    "lint": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives",
    "lint:fix": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types",
    "test": "bun test",
    "test:watch": "bun test --watch"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "@types/react": "^19.3.0",
    "typescript": "^5.9.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-plugin-unused-imports": "^4.4.1",
    "@trpc/client": "^11.25.1"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "js-sha256": "^1.0.0",
    "linkify-it": "^6.1.0",
    "mediasoup": "^3.32.2",
    "zod": "^4.6.7"
  }
}