{
  "name": "@sharkord/scripts",
  "version": "0.0.30",
  "type": "module",
  "private": true,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "format": "prettier --write \"**/*.ts*\"",
    "format:check": "prettier --check \"**/*.ts*\"",
    "lint": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives",
    "lint:fix": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types",
    "synci18n": "bun ./src/sync-i18n.ts"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^5.9.3",
    "@types/linkify-it": "^5.0.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-plugin-unused-imports": "^4.4.1"
  },
  "dependencies": {}
}