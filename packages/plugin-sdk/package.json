{
  "name": "@sharkord/plugin-sdk",
  "version": "0.0.31",
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "format": "prettier --write \"**/*.ts*\"",
    "format:check": "prettier --check \"**/*.ts*\"",
    "lint": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives",
    "lint:fix": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "mediasoup": "^3.32.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@sharkord/shared": "workspace:*",
    "typescript": "^5.9.3",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "eslint": "^8.57.1",
    "eslint-plugin-unused-imports": "^4.4.1"
  },
  "peerDependencies": {
    "mediasoup": "^3.32.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}