{
  "name": "@sharkord/plugin-sdk",
  "version": "0.0.29",
  "type": "module",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "format": "prettier --write \"**/*.ts*\"",
    "format:check": "prettier --check \"**/*.ts*\"",
    "lint": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives",
    "lint:fix": "eslint ./src/**/*.ts --ext ts --report-unused-disable-directives --fix",
    "check-types": "tsc --noEmit",
    "magic": "bun --bun run lint:fix && bun --bun run format && bun --bun run check-types"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "mediasoup": "^3.19.11",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@sharkord/shared": "workspace:*",
    "typescript": "^5",
    "@typescript-eslint/eslint-plugin": "^8.46.1",
    "eslint": "^8.56.0",
    "eslint-plugin-unused-imports": "^4.1.4"
  },
  "peerDependencies": {
    "mediasoup": "^3.19.11",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  }
}