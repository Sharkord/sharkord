{
  "name": "sharkord",
  "version": "0.0.29",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "mediasoup",
    "electron"
  ],
  "scripts": {
    "test": "bun run --filter '*' test",
    "test:e2e": "bun run --filter '@sharkord/e2e' test:e2e",
    "format": "bun run --filter '*' format",
    "format:check": "bun run --filter '*' format:check",
    "check-types": "bun run --filter '*' check-types",
    "lint": "bun run --filter '*' lint",
    "knip": "knip",
    "knip:production": "knip --production",
    "magic": "bun run format && bun run check-types && bun run lint"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "knip": "^5.80.0",
    "prettier": "^3.5.3",
    "prettier-plugin-organize-imports": "^4.1.0"
  },
  "overrides": {
    "@types/bun": "1.3.14"
  }
}